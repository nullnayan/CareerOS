# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it contains secrets.

# ── Database ──────────────────────────────────────────────────────────────────
# Matches docker-compose.yml defaults for local dev
DATABASE_URL=postgresql://careeros:careeros_dev_password@localhost:5455/careeros

# ── Vector store (Qdrant) ──────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── LLM providers (at least one is required for AI features) ─────────────────
# Groq — fast Llama inference (free tier at console.groq.com/keys)
# Google Gemini
# Anthropic Claude
# Optional: local Ollama server

# ── Model routing for tailoring pipeline ──────────────────────────────────────

# ── Auth / SMTP ───────────────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# For Gmail: generate an App Password at myaccount.google.com/apppasswords
SMTP_PASSWORD=your_app_password_here

# ── GitHub OAuth App (repo-scoped) ────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# URL of the frontend (used for OAuth redirect)
FRONTEND_URL=http://localhost:3000

# ── Job listings ──────────────────────────────────────────────────────────────
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_ENCRYPTION_KEY=generate_a_real_key_before_using

# ── Rate limiting (requests per minute per user) ─────────────────────────────
RATE_LIMIT_AI_RPM=10
RATE_LIMIT_UPLOAD_RPM=20
GROQ_API_KEY_PARSING=
GROQ_API_KEY_CHAT=
GROQ_API_KEY_TAILORING=
GROQ_API_KEY_ATS=
GROQ_API_KEY_CLASSIFICATION=
