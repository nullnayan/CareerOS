{
  "source_id": "foundit",
  "preferred_tool": "crawl4ai",
  "official_url": "https://www.foundit.in/",
  "approved_domains": ["foundit.in"],
  "entry_url": "https://www.foundit.in/srp/results",
  "query_parameters": {"query": "role", "locations": "location"},
  "scroll_steps": 2,
  "page_ready_selector": "body",
  "job_link_selectors": ["a[href*='/job/']", "a[href*='/jobs/']"],
  "next_selectors": ["a[rel='next']", "a[aria-label*='Next']"],
  "job_card_selector": "article, [class*='jobTuple'], [class*='job-card']",
  "title_selectors": ["h1", "h2", "h3", "[class*='title']"],
  "company_selectors": ["[class*='company']"],
  "location_selectors": ["[class*='location']"],
  "description_selectors": ["[class*='description']", "main"],
  "empty_indicators": ["no jobs found", "no matching jobs", "no results"],
  "login_indicators": ["sign in to continue", "log in to continue"],
  "challenge_indicators": ["captcha", "verify you are human", "access denied", "challenge-platform"],
  "max_pages": 3,
  "max_details": 8,
  "load_more_selector": null,
  "robots_required": true,
  "access_state": "unverified; direct access outcome must be checked before enabling"
}


